# Base sdkconfig.defaults for ESP32 RNG Analysis
# This file enables all peripherals used across the 8 entropy modes.
# Per-mode files (sdkconfig.defaults.mode0 … mode7) override
# CONFIG_RNG_ENTROPY_MODE on top of this base.

# ---- UART output ----
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# ---- WiFi (modes 1, 3, 5, 7) ----
# WiFi is automatically enabled by including the esp_wifi component.
# No additional keys are required for station-mode RF-only operation.

# ---- Bluetooth (modes 2, 3, 6, 7) ----
# Enable the BT controller and Bluedroid host stack.
# BLE-only mode is used to minimise RAM pressure alongside WiFi.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
# Release Classic-BT RAM when not needed (done at runtime in firmware too)
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y

# ---- Project RNG settings (overridden per mode) ----
CONFIG_RNG_ENTROPY_MODE=7
CONFIG_RNG_NUM_SAMPLES=1048576

# ---- Flash size ----
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# ---- Partition table ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- Miscellaneous ----
# Reduce log verbosity to avoid polluting sample output over UART
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL=2
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
